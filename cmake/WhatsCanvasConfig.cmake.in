include(CMakeFindDependencyMacro)

find_dependency(OpenGL)

get_filename_component(_WHATSCANVAS_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(WhatsCanvas_VERSION "@PROJECT_VERSION@")
set(WhatsCanvas_INCLUDE_DIR "${_WHATSCANVAS_PREFIX}/include")
set(WhatsCanvas_LIBRARY_DIR "${_WHATSCANVAS_PREFIX}/@CMAKE_INSTALL_LIBDIR@")

if (NOT TARGET WhatsCanvas::GLAD)
    add_library(WhatsCanvas::GLAD STATIC IMPORTED)
    set_target_properties(WhatsCanvas::GLAD PROPERTIES
        IMPORTED_LOCATION "${_WHATSCANVAS_PREFIX}/@WHATSCANVAS_GLAD_PACKAGE_LOCATION@"
    )
endif()

if (NOT TARGET WhatsCanvas::GLFW)
    add_library(WhatsCanvas::GLFW STATIC IMPORTED)
    set_target_properties(WhatsCanvas::GLFW PROPERTIES
        IMPORTED_LOCATION "${_WHATSCANVAS_PREFIX}/@WHATSCANVAS_GLFW_PACKAGE_LOCATION@"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/WhatsCanvasTargets.cmake")

if (TARGET WhatsCanvas::WhatsCanvasOpenGL AND NOT TARGET WhatsCanvas::OpenGL)
    add_library(WhatsCanvas::OpenGL ALIAS WhatsCanvas::WhatsCanvasOpenGL)
endif()

if (TARGET WhatsCanvas::WhatsCanvasOpenGL AND NOT "@WHATSCANVAS_OPENGL_PACKAGE_IMPLIB@" STREQUAL "")
    set_target_properties(WhatsCanvas::WhatsCanvasOpenGL PROPERTIES
        IMPORTED_IMPLIB "${_WHATSCANVAS_PREFIX}/@WHATSCANVAS_OPENGL_PACKAGE_IMPLIB@"
    )
endif()